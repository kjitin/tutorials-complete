---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  headings.length > 1 && (
    <nav class="toc" aria-label="On this page">
      <div class="toc-title">On this page</div>
      <ul>
        {headings.map((h) => (
          <li class={`d${h.depth}`}>
            <a href={`#${h.slug}`} data-toc={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  if (links.length) {
    const targets = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
    const onScroll = () => {
      let current = targets[0]?.id;
      for (const t of targets) if (t.getBoundingClientRect().top < 120) current = t.id;
      links.forEach((a) => a.classList.toggle('active', a.dataset.toc === current));
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .toc {
    font-size: 13.5px;
  }
  .toc-title {
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  a {
    display: block;
    padding: 4px 0 4px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    line-height: 1.45;
  }
  .d3 a {
    padding-left: 26px;
    font-size: 13px;
  }
  a:hover {
    color: var(--text);
  }
  a:global(.active) {
    color: var(--text);
    border-left-color: var(--brand);
  }
</style>
