---
import { SITE, TRACKS } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <div class="brand">{SITE.name}</div>
      <p class="muted">{SITE.tagline}</p>
      <p class="muted small">Examples target Java 21 LTS and Spring Boot 4.x (Spring Framework 7).</p>
    </div>
    <div>
      <h4>Learn</h4>
      {TRACKS.map((t) => <a href={`/${t.id}/`}>{t.title}</a>)}
    </div>
    <div>
      <h4>Practice</h4>
      <a href="/interview/">Interview Q&amp;A</a>
      <a href="/quiz/">Quizzes</a>
      <a href="/progress/">My progress</a>
    </div>
  </div>
  <div class="container copy">© {year} {SITE.author}. Built for engineers preparing for their next role.</div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
    padding: 48px 0 28px;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 32px;
  }
  .brand {
    font-weight: 750;
    font-size: 18px;
    margin-bottom: 8px;
  }
  .muted {
    color: var(--muted);
    margin: 0 0 6px;
    max-width: 380px;
  }
  .small {
    font-size: 13px;
  }
  h4 {
    margin: 0 0 12px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  a {
    display: block;
    color: var(--text-soft);
    font-size: 14.5px;
    padding: 3px 0;
  }
  a:hover {
    color: var(--text);
  }
  .copy {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .grid > :first-child {
      grid-column: 1 / -1;
    }
  }
</style>
