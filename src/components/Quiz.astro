---
import { Code } from 'astro:components';
import Icon from './Icon.astro';
import { inline } from '../lib/inline';
import type { Quiz } from '../data/quizzes/types';

interface Props {
  quiz: Quiz;
}
const { quiz } = Astro.props;
const total = quiz.questions.length;
const kinds = new Set(quiz.questions.map((q) => q.type ?? 'mcq'));
const intro = kinds.has('estimate')
  ? 'Type your estimate — any unit suffix works (1.5k, 2M, 3e9). Within 2× of the reference counts; within 1.25× is a bullseye. Answer fast for bonus XP.'
  : kinds.has('tradeoff')
    ? 'Pick a side and every reason that justifies it. You only win the duel with the right call and the right reasoning.'
    : "Pick an answer to see instantly whether you're right, with an explanation. Questions are shuffled every attempt.";
---

<div class="quiz" data-quiz={quiz.id} data-total={total}>
  <section class="qz-start card" data-stage="start">
    <div class="qz-start-icon"><Icon name="target" size={26} /></div>
    <h2>{total} questions</h2>
    <p>{intro}</p>
    <p class="qz-best" data-best hidden></p>
    <button class="btn btn-primary" data-start><Icon name="play" size={14} /> Start quiz</button>
  </section>

  <section class="qz-run" data-stage="run" hidden>
    <div class="qz-head">
      <span>Question <b data-qnum>1</b> of {total}</span>
      <span class="qz-score">Score <b data-score>0</b><span data-game> · <b data-run-xp>0</b> XP</span></span>
    </div>
    <div class="progress-bar"><span data-qbar></span></div>

    {
      quiz.questions.map((item, i) => (
        <article class="qz-q card" data-q={i} data-type={item.type ?? 'mcq'} data-answer={item.answer} hidden>
          {item.type === 'estimate' && (
            <div class="qz-kind">
              <span>🧮 Estimation</span>
              <span class="qz-timer" data-timer data-speed={item.speedSec ?? 60}>
                <Icon name="clock" size={13} /> <b>0</b>s<span data-game> · bonus under {item.speedSec ?? 60}s</span>
              </span>
            </div>
          )}
          {item.type === 'tradeoff' && <div class="qz-kind"><span>⚔️ Trade-off duel</span></div>}
          <h3 set:html={inline(item.q)} />
          {item.code && (
            <div class="qz-code" data-no-copy>
              <Code code={item.code.trim()} lang="java" themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} />
            </div>
          )}

          {(item.type ?? 'mcq') === 'mcq' && 'options' in item && (
            <div class="qz-opts" role="group">
              {item.options.map((opt, oi) => (
                <button type="button" class="qz-opt" data-opt={oi}>
                  <span class="qz-letter">{String.fromCharCode(65 + oi)}</span>
                  <span set:html={inline(opt)} />
                </button>
              ))}
            </div>
          )}

          {item.type === 'estimate' && (
            <>
              {item.given && (
                <ul class="qz-given">
                  {item.given.map((g) => (
                    <li set:html={inline(g)} />
                  ))}
                </ul>
              )}
              <form class="qz-est" data-est>
                <label class="qz-est-field">
                  <input type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 1.5k, 2M, 3e9" aria-label={`Your estimate in ${item.unit}`} data-input />
                  <span class="qz-unit">{item.unit}</span>
                </label>
                <button type="submit" class="btn btn-primary" data-lock>Lock in</button>
              </form>
              <p class="qz-err" data-err hidden>Enter a positive number, optionally with k / M / B / T.</p>
            </>
          )}

          {item.type === 'tradeoff' && (
            <>
              {item.constraint && (
                <p class="qz-constraint">
                  <b>Constraint</b> <span set:html={inline(item.constraint)} />
                </p>
              )}
              <div class="qz-duel" role="radiogroup" aria-label="Pick a side">
                {item.options.map((opt, oi) => (
                  <>
                    {oi === 1 && <span class="qz-vs">VS</span>}
                    <button type="button" class="qz-side" role="radio" aria-checked="false" data-side={oi}>
                      <span set:html={inline(opt)} />
                    </button>
                  </>
                ))}
              </div>
              <p class="qz-sub">Why? Tick every reason that justifies the right call.</p>
              <div class="qz-reasons">
                {item.reasons.map((r) => (
                  <label class="qz-reason" data-valid={String(r.valid)}>
                    <input type="checkbox" />
                    <span set:html={inline(r.text)} />
                  </label>
                ))}
              </div>
              <div class="qz-lock-row">
                <button type="button" class="btn btn-primary" data-lock disabled>Lock in</button>
              </div>
            </>
          )}

          <div class="qz-explain" hidden>
            <strong class="qz-verdict" />
            <span class="qz-xp-gain" data-game />
            <p class="qz-detail" hidden />
            <p set:html={inline(item.explain)} />
          </div>
        </article>
      ))
    }

    <div class="qz-nav">
      <button class="btn btn-primary" data-next disabled>Next question <Icon name="arrow-right" size={14} /></button>
    </div>
  </section>

  <section class="qz-result card" data-stage="result" hidden>
    <div class="ring" data-ring><span data-pct>0%</span></div>
    <h2 data-verdict>Nice work</h2>
    <p>You scored <b data-final>0</b> out of {total}.</p>
    <p class="qz-xp-total" data-game>+<b data-final-xp>0</b> XP this attempt <span data-xp-best></span></p>
    <div class="qz-result-actions">
      <button class="btn btn-primary" data-retry><Icon name="shuffle" size={14} /> Try again</button>
      <a class="btn" href="/quiz/">All quizzes</a>
      <a class="btn" href={`/${quiz.track}/`}>Review lessons</a>
    </div>
  </section>
</div>

<script>
  import { progress } from '../scripts/progress';
  import { XP, formatAmount, parseAmount, recordQuiz, scoreEstimate, scoreTradeoff, stats } from '../scripts/game';

  const shuffle = <T,>(a: T[]) => {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((root) => {
    const id = root.dataset.quiz!;
    const total = Number(root.dataset.total);
    const stage = (name: string) =>
      root.querySelectorAll<HTMLElement>('[data-stage]').forEach((s) => (s.hidden = s.dataset.stage !== name));
    const questions = [...root.querySelectorAll<HTMLElement>('[data-q]')];
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let order: number[] = [];
    let pos = 0;
    let score = 0;
    let runXp = 0;
    let hits = { bullseyes: [] as string[], tradeoffs: [] as string[], speedy: [] as string[] };
    let timer: ReturnType<typeof setInterval> | undefined;
    let shownAt = 0;

    const showBest = () => {
      const best = progress.quizScores()[id];
      const el = root.querySelector<HTMLElement>('[data-best]')!;
      if (best) {
        el.hidden = false;
        const bestXp = stats().quizXp[id];
        el.textContent = `Your best: ${best.best}/${best.total} · last attempt: ${best.last}/${best.total}${bestXp ? ` · best ${bestXp} XP` : ''}`;
      }
    };

    function reset(q: HTMLElement) {
      q.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((b) => {
        b.disabled = false;
        b.className = 'qz-opt';
      });
      q.querySelectorAll<HTMLButtonElement>('[data-side]').forEach((b) => {
        b.disabled = false;
        b.className = 'qz-side';
        b.setAttribute('aria-checked', 'false');
      });
      q.querySelectorAll<HTMLLabelElement>('.qz-reason').forEach((l) => {
        l.className = 'qz-reason';
        const box = l.querySelector('input')!;
        box.checked = false;
        box.disabled = false;
      });
      const reasons = q.querySelector('.qz-reasons');
      if (reasons) shuffle([...reasons.children]).forEach((c) => reasons.appendChild(c));
      const input = q.querySelector<HTMLInputElement>('[data-input]');
      if (input) {
        input.value = '';
        input.disabled = false;
      }
      q.querySelectorAll<HTMLButtonElement>('[data-lock]').forEach((b) => (b.disabled = q.dataset.type === 'tradeoff'));
      q.querySelector<HTMLElement>('[data-err]')?.setAttribute('hidden', '');
      q.querySelector<HTMLElement>('.qz-explain')!.hidden = true;
      q.querySelector<HTMLElement>('.qz-detail')!.hidden = true;
    }

    function startTimer(q: HTMLElement) {
      clearInterval(timer);
      shownAt = performance.now();
      const el = q.querySelector<HTMLElement>('[data-timer]');
      if (!el) return;
      const b = el.querySelector('b')!;
      const limit = Number(el.dataset.speed);
      el.classList.remove('late');
      b.textContent = '0';
      timer = setInterval(() => {
        const sec = Math.floor((performance.now() - shownAt) / 1000);
        b.textContent = String(sec);
        el.classList.toggle('late', sec > limit);
      }, 250);
    }

    function show() {
      questions.forEach((q) => (q.hidden = true));
      const q = questions[order[pos]];
      reset(q);
      q.hidden = false;
      root.querySelector('[data-qnum]')!.textContent = String(pos + 1);
      root.querySelector('[data-score]')!.textContent = String(score);
      root.querySelector('[data-run-xp]')!.textContent = String(runXp);
      root.querySelector<HTMLElement>('[data-qbar]')!.style.width = `${(pos / total) * 100}%`;
      nextBtn.disabled = true;
      nextBtn.firstChild!.textContent = pos === total - 1 ? 'See results ' : 'Next question ';
      startTimer(q);
      q.querySelector<HTMLInputElement>('[data-input]')?.focus({ preventScroll: true });
    }

    function start() {
      order = shuffle(questions.map((_, i) => i));
      pos = 0;
      score = 0;
      runXp = 0;
      hits = { bullseyes: [], tradeoffs: [], speedy: [] };
      stage('run');
      show();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /** Common feedback once a question is answered. */
    function finish(q: HTMLElement, correct: boolean, xp: number, verdict: string, detail?: string) {
      clearInterval(timer);
      if (correct) score++;
      runXp += xp;
      const ex = q.querySelector<HTMLElement>('.qz-explain')!;
      ex.hidden = false;
      ex.classList.toggle('is-correct', correct);
      ex.querySelector('.qz-verdict')!.textContent = verdict;
      ex.querySelector('.qz-xp-gain')!.textContent = xp ? `+${xp} XP` : '';
      const d = ex.querySelector<HTMLElement>('.qz-detail')!;
      if (detail) {
        d.hidden = false;
        d.innerHTML = detail;
      }
      root.querySelector('[data-score]')!.textContent = String(score);
      root.querySelector('[data-run-xp]')!.textContent = String(runXp);
      nextBtn.disabled = false;
      nextBtn.focus({ preventScroll: true });
    }

    questions.forEach((q) => {
      const answer = Number(q.dataset.answer);
      const key = `${id}:${q.dataset.q}`;

      // Multiple choice
      q.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const chosen = Number(btn.dataset.opt);
          const correct = chosen === answer;
          q.querySelectorAll<HTMLButtonElement>('[data-opt]').forEach((b) => {
            b.disabled = true;
            const i = Number(b.dataset.opt);
            if (i === answer) b.classList.add('correct');
            else if (i === chosen) b.classList.add('wrong');
          });
          finish(q, correct, correct ? XP.mcq : 0, correct ? 'Correct!' : 'Not quite.');
        }),
      );

      // Estimation
      const form = q.querySelector<HTMLFormElement>('[data-est]');
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const input = form.querySelector<HTMLInputElement>('[data-input]')!;
        if (input.disabled) return;
        const guess = parseAmount(input.value);
        const err = q.querySelector<HTMLElement>('[data-err]')!;
        if (!(guess > 0)) {
          err.hidden = false;
          return;
        }
        err.hidden = true;
        input.disabled = true;
        form.querySelector<HTMLButtonElement>('[data-lock]')!.disabled = true;
        const sec = (performance.now() - shownAt) / 1000;
        const limit = Number(q.querySelector<HTMLElement>('[data-timer]')?.dataset.speed ?? 60);
        const r = scoreEstimate(guess, answer);
        const fast = r.correct && sec <= limit;
        let xp = r.xp;
        if (fast) {
          xp += XP.estimate.speed;
          hits.speedy.push(key);
        }
        if (r.tier === 'bullseye') hits.bullseyes.push(key);
        const unit = q.querySelector('.qz-unit')!.textContent;
        const verdict = { bullseye: '🎯 Bullseye!', close: '✅ Close enough!', ballpark: '🟡 Right ballpark, but over 2× off.', miss: '❌ Way off.' }[r.tier];
        const off = r.ratio === 1 ? 'spot on' : `${r.ratio.toFixed(1)}× ${guess > answer ? 'high' : 'low'}`;
        finish(
          q,
          r.correct,
          xp,
          verdict,
          `You said <b>${formatAmount(guess)} ${unit}</b> · reference <b>${formatAmount(answer)} ${unit}</b> · ${off} · ${Math.round(sec)}s${fast ? ' ⚡ speed bonus' : ''}`,
        );
      });

      // Trade-off duel
      const sides = [...q.querySelectorAll<HTMLButtonElement>('[data-side]')];
      const lock = q.dataset.type === 'tradeoff' ? q.querySelector<HTMLButtonElement>('[data-lock]') : null;
      let side = -1;
      sides.forEach((b) =>
        b.addEventListener('click', () => {
          side = Number(b.dataset.side);
          sides.forEach((x) => x.setAttribute('aria-checked', String(x === b)));
          lock!.disabled = false;
        }),
      );
      lock?.addEventListener('click', () => {
        const labels = [...q.querySelectorAll<HTMLLabelElement>('.qz-reason')];
        const picked = labels.map((l) => l.querySelector('input')!.checked);
        const valid = labels.map((l) => l.dataset.valid === 'true');
        const callRight = side === answer;
        const r = scoreTradeoff(callRight, picked, valid);
        if (r.perfect) hits.tradeoffs.push(key);
        lock.disabled = true;
        sides.forEach((b) => {
          b.disabled = true;
          const i = Number(b.dataset.side);
          if (i === answer) b.classList.add('correct');
          else if (i === side) b.classList.add('wrong');
        });
        labels.forEach((l, i) => {
          l.querySelector('input')!.disabled = true;
          if (valid[i]) l.classList.add(picked[i] ? 'hit' : 'missed');
          else if (picked[i]) l.classList.add('wrong');
        });
        const verdict = r.perfect
          ? '🏆 Duel won — right call, right reasons.'
          : callRight
            ? 'Right call, but the reasoning needs work.'
            : 'Wrong call.';
        finish(
          q,
          r.perfect,
          r.xp,
          verdict,
          `Reasons: <b>${r.hits}/${r.validCount}</b> valid picked${r.wrong ? ` · <b>${r.wrong}</b> invalid picked` : ''}. Green = valid reason, red = invalid.`,
        );
      });
    });

    nextBtn.addEventListener('click', () => {
      if (pos < total - 1) {
        pos++;
        show();
        return;
      }
      const prevBest = stats().quizXp[id] ?? 0;
      // Record XP first: the score write is what makes the quiz count, so the
      // XP toast fires once with the full total.
      recordQuiz(id, runXp, hits);
      progress.saveQuiz(id, score, total);
      const pct = Math.round((score / total) * 100);
      root.querySelector('[data-final]')!.textContent = String(score);
      root.querySelector('[data-final-xp]')!.textContent = String(runXp);
      root.querySelector('[data-xp-best]')!.textContent =
        runXp > prevBest && prevBest > 0 ? `· new personal best! (was ${prevBest})` : prevBest ? `· best ${Math.max(prevBest, runXp)}` : '';
      root.querySelector('[data-pct]')!.textContent = `${pct}%`;
      root.querySelector<HTMLElement>('[data-ring]')!.style.setProperty('--pct', String(pct));
      root.querySelector('[data-verdict]')!.textContent =
        pct >= 90 ? 'Outstanding! 🏆' : pct >= 70 ? 'Great job!' : pct >= 50 ? 'Getting there' : 'Keep practising';
      stage('result');
    });

    root.querySelector('[data-start]')!.addEventListener('click', start);
    root.querySelector('[data-retry]')!.addEventListener('click', start);
    showBest();
  });
</script>

<style>
  .quiz {
    scroll-margin-top: calc(var(--header-h) + 20px);
  }
  .qz-start,
  .qz-result {
    padding: 40px 28px;
    text-align: center;
  }
  .qz-start-icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    margin-bottom: 12px;
  }
  .qz-start h2,
  .qz-result h2 {
    margin: 0 0 8px;
    font-size: 26px;
  }
  .qz-start p,
  .qz-result p {
    color: var(--muted);
    max-width: 480px;
    margin: 0 auto 20px;
  }
  .qz-best {
    color: var(--ok) !important;
    font-weight: 550;
  }
  .qz-head {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .qz-head b {
    color: var(--text);
  }
  .qz-q {
    margin-top: 18px;
    padding: 24px;
  }
  .qz-q h3 {
    margin: 0 0 16px;
    font-size: 18.5px;
    line-height: 1.45;
  }
  .qz-q :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--surface-2);
  }
  .qz-q :global(pre code) {
    padding: 0;
    background: none;
  }
  .qz-code {
    margin-bottom: 16px;
  }
  .qz-opts {
    display: grid;
    gap: 8px;
  }
  .qz-opt {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    padding: 12px 14px;
    text-align: left;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-soft);
    font: 15px/1.5 var(--font-sans);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .qz-opt:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--text);
  }
  .qz-opt:disabled {
    cursor: default;
  }
  .qz-letter {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    font: 600 12px var(--font-mono);
  }
  .qz-opt:global(.correct) {
    border-color: var(--ok);
    background: color-mix(in srgb, var(--ok) 12%, var(--surface-2));
    color: var(--text);
  }
  .qz-opt:global(.correct) .qz-letter {
    background: var(--ok);
    border-color: var(--ok);
    color: #fff;
  }
  .qz-opt:global(.wrong) {
    border-color: var(--err);
    background: color-mix(in srgb, var(--err) 10%, var(--surface-2));
  }
  .qz-opt:global(.wrong) .qz-letter {
    background: var(--err);
    border-color: var(--err);
    color: #fff;
  }
  .qz-explain {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 10px;
    border-left: 3px solid var(--err);
    background: var(--surface-2);
    font-size: 15px;
  }
  .qz-explain:global(.is-correct) {
    border-left-color: var(--ok);
  }
  .qz-explain p {
    margin: 4px 0 0;
    color: var(--text-soft);
  }
  .qz-verdict {
    color: var(--err);
  }
  .qz-explain:global(.is-correct) .qz-verdict {
    color: var(--ok);
  }
  .qz-nav {
    display: flex;
    justify-content: flex-end;
    margin-top: 16px;
  }
  .qz-nav .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    filter: grayscale(0.5);
  }
  .ring {
    --pct: 0;
    width: 132px;
    height: 132px;
    margin: 0 auto 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(closest-side, var(--surface) 78%, transparent 79%),
      conic-gradient(var(--brand-2) calc(var(--pct) * 1%), var(--surface-2) 0);
  }
  .ring span {
    font-size: 28px;
    font-weight: 750;
  }
  .qz-result-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .qz-kind {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .qz-timer {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
    color: var(--muted);
  }
  .qz-timer b {
    font-family: var(--font-mono);
    color: var(--text);
  }
  .qz-timer:global(.late) b {
    color: var(--warn);
  }
  .qz-given {
    margin: 0 0 16px;
    padding: 12px 16px 12px 32px;
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--text-soft);
    font-size: 14.5px;
  }
  .qz-given li + li {
    margin-top: 4px;
  }
  .qz-est {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .qz-est-field {
    flex: 1 1 220px;
    display: flex;
    align-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .qz-est-field:focus-within {
    border-color: var(--accent);
  }
  .qz-est-field input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: 500 16px var(--font-mono);
  }
  .qz-unit {
    padding: 0 14px;
    color: var(--muted);
    font: 600 13px var(--font-mono);
  }
  .qz-err {
    margin: 8px 0 0;
    color: var(--err);
    font-size: 13.5px;
  }
  .qz-constraint {
    margin: 0 0 14px;
