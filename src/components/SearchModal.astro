---
import Icon from './Icon.astro';
---

<dialog class="search-modal" data-search-dialog aria-label="Search">
  <div class="search-box">
    <div class="search-input">
      <Icon name="search" size={18} />
      <input type="search" placeholder="Search lessons, patterns, interview questions…" autocomplete="off" spellcheck="false" />
      <kbd>esc</kbd>
    </div>
    <div class="search-filters" role="tablist" aria-label="Filter by section">
      <button data-filter="" aria-pressed="true">All</button>
      <button data-filter="Java">Java</button>
      <button data-filter="Spring Boot">Spring Boot</button>
      <button data-filter="Design Patterns">Patterns</button>
      <button data-filter="Interview">Interview</button>
    </div>
    <ul class="search-results" role="listbox"></ul>
    <p class="search-status">Type to search across every lesson and interview question.</p>
  </div>
</dialog>

<script>
  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: { title?: string; section?: string };
    sub_results?: { title: string; url: string; excerpt: string }[];
  };
  type Pagefind = {
    init: () => Promise<void>;
    debouncedSearch: (
      q: string,
      opts?: object,
      ms?: number,
    ) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')!;
  const input = dialog.querySelector('input')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;
  const status = dialog.querySelector<HTMLParagraphElement>('.search-status')!;
  const filterBtns = [...dialog.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  let pagefind: Pagefind | null = null;
  let filter = '';
  let active = 0;

  const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
  document.querySelectorAll('[data-search-kbd]').forEach((k) => (k.textContent = isMac ? '⌘K' : 'Ctrl K'));

  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      const url = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
      await pagefind.init();
    } catch {
      status.textContent = 'The search index is generated by `npm run build` — run a production build to enable search.';
    }
    return pagefind;
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    loadPagefind();
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  document.addEventListener('keydown', (e) => {
    const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  filterBtns.forEach((b) =>
    b.addEventListener('click', () => {
      filter = b.dataset.filter ?? '';
      filterBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      search();
      input.focus();
    }),
  );

  function highlight() {
    [...list.children].forEach((li, i) => li.classList.toggle('active', i === active));
    list.children[active]?.scrollIntoView({ block: 'nearest' });
  }

  const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  async function search() {
    const q = input.value.trim();
    const pf = await loadPagefind();
    if (!pf) return;
    if (!q) {
      list.innerHTML = '';
      status.textContent = 'Type to search across every lesson and interview question.';
      return;
    }
    const res = await pf.debouncedSearch(q, filter ? { filters: { section: filter } } : {}, 150);
    if (!res) return; // superseded by a newer query
    const data = await Promise.all(res.results.slice(0, 10).map((r) => r.data()));
    active = 0;
    list.innerHTML = data
      .map((d) => {
        const sub = d.sub_results?.[0];
        const url = sub && sub.url !== d.url ? sub.url : d.url;
        const excerpt = sub?.excerpt || d.excerpt;
        const subTitle = sub && sub.title !== d.meta.title ? ` › ${escapeHtml(sub.title)}` : '';
        return `<li role="option"><a href="${url}">
          <span class="r-top"><span class="r-section">${escapeHtml(d.meta.section ?? '')}</span>
          <span class="r-title">${escapeHtml(d.meta.title ?? url)}${subTitle}</span></span>
          <span class="r-excerpt">${excerpt}</span></a></li>`;
      })
      .join('');
    status.textContent = data.length ? `${res.results.length} result${res.results.length === 1 ? '' : 's'}` : `No results for “${q}”`;
    highlight();
  }

  input.addEventListener('input', search);
  input.addEventListener('keydown', (e) => {
    const n = list.children.length;
    if (e.key === 'ArrowDown' && n) {
      e.preventDefault();
      active = (active + 1) % n;
      highlight();
    } else if (e.key === 'ArrowUp' && n) {
      e.preventDefault();
      active = (active - 1 + n) % n;
      highlight();
    } else if (e.key === 'Enter') {
      list.children[active]?.querySelector('a')?.click();
    }
  });
</script>

<style>
  .search-modal {
    width: min(680px, calc(100vw - 24px));
    max-height: min(640px, calc(100dvh - 80px));
    margin: 72px auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    background: var(--bg-elev);
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .search-modal::backdrop {
    background: rgba(5, 7, 12, 0.6);
    backdrop-filter: blur(4px);
  }
  .search-box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .search-input {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .search-input input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: 500 16px var(--font-sans);
  }
  .search-input input::-webkit-search-cancel-button {
    display: none;
  }
  .search-filters {
    display: flex;
    gap: 6px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }
  .search-filters button {
    padding: 4px 11px;
    border-radius: 99px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    font: 500 12.5px var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
  }
  .search-filters button[aria-pressed='true'] {
    color: var(--text);
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 12%, transparent);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }
  .search-results :global(li a) {
    display: grid;
    gap: 4px;
    padding: 10px 12px;
    border-radius: 10px;
  }
  .search-results :global(li.active a),
  .search-results :global(li a:hover) {
    background: var(--surface-2);
  }
  .search-results :global(.r-top) {
    display: flex;
    gap: 8px;
    align-items: baseline;
    min-width: 0;
  }
  .search-results :global(.r-section) {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand);
  }
  .search-results :global(.r-title) {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-results :global(.r-excerpt) {
    font-size: 13.5px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-results :global(mark) {
    background: color-mix(in srgb, var(--brand) 25%, transparent);
    color: var(--text);
    border-radius: 3px;
    padding: 0 2px;
  }
  .search-status {
    margin: 0;
    padding: 10px 18px 14px;
    font-size: 13px;
    color: var(--muted);
  }
</style>
