---
interface Props {
  labels: string[];
}
const { labels } = Astro.props;
---

<div class="code-tabs" data-code-tabs>
  <div class="tab-list" role="tablist">
    {
      labels.map((label, i) => (
        <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
          {label}
        </button>
      ))
    }
  </div>
  <div class="tab-panels"><slot /></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-code-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = () => [...root.querySelector('.tab-panels')!.children] as HTMLElement[];
    const show = (idx: number) => {
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === idx)));
      panels().forEach((p, i) => (p.hidden = i !== idx));
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    show(0);
  });
</script>

<style>
  .code-tabs {
    margin: 1.4em 0;
  }
  .tab-list {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 4px;
    margin-bottom: 8px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    width: fit-content;
    max-width: 100%;
  }
  .tab-list button {
    padding: 6px 14px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    font: 550 13px var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
  }
  .tab-list button[aria-selected='true'] {
    background: var(--surface-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .tab-panels > :global([hidden]) {
    display: none;
  }
</style>
