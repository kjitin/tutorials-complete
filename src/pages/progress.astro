---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { TRACKS } from '../site.config';
import { getLessons, lessonKey, lessonUrl } from '../lib/lessons';
import { QUIZZES } from '../data/quizzes';

const tracks = await Promise.all(
  TRACKS.map(async (t) => {
    const lessons = await getLessons(t.id);
    return {
      ...t,
      lessons: lessons.map((l) => ({ key: lessonKey(t.id, l.id), url: lessonUrl(t.id, l.id), title: l.data.title })),
    };
  }),
);
const quizzes = QUIZZES.map((q) => ({ id: q.id, title: q.title, total: q.questions.length }));
---

<BaseLayout title="My Progress" description="Your completed lessons, bookmarks and quiz scores.">
  <div class="container page">
    <span class="eyebrow">Dashboard</span>
    <h1>My progress</h1>
    <p class="lede">Saved privately in this browser — nothing is sent to a server.</p>

    <section class="card level-panel" id="level" data-game>
      <div class="lv-main">
        <div class="lv-badge"><span>Lv</span><b data-lv-index>1</b></div>
        <div class="lv-info">
          <span class="lv-name" data-lv-name>Intern</span>
          <div class="progress-bar lv-bar"><span data-lv-bar></span></div>
          <span class="lv-next" data-lv-next></span>
        </div>
        <div class="lv-stats">
          <div><b data-lv-xp>0</b><span>total XP</span></div>
          <div><b data-lv-streak>0</b><span>day streak 🔥</span></div>
          <div><b data-lv-best>0</b><span>best streak</span></div>
        </div>
      </div>
      <p class="lv-breakdown" data-lv-breakdown></p>
      <h2><Icon name="trophy" size={17} /> Badges <span class="lv-count" data-badge-count></span></h2>
      <ul class="badges" data-badges></ul>
    </section>

    <div class="track-grid">
      {
        tracks.map((t) => (
          <div class="tp card" style={`--accent:${t.accent}`} data-track={t.id} data-lessons={JSON.stringify(t.lessons)}>
            <div class="tp-head">
              <span class="tp-icon">
                <Icon name={t.icon} size={18} />
              </span>
              <span class="tp-title">{t.title}</span>
              <span class="tp-pct" data-pct>
                0%
              </span>
            </div>
            <div class="progress-bar">
              <span data-bar />
            </div>
            <div class="tp-foot">
              <span>
                <b data-count>0</b>/{t.lessons.length} lessons
              </span>
              <a href={t.lessons[0]?.url} data-next>
                Start <Icon name="arrow-right" size={13} />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="two">
      <section class="card panel">
        <h2><Icon name="bookmark" size={17} /> Bookmarks</h2>
        <ul class="list" data-bookmarks></ul>
        <p class="empty" data-bookmarks-empty>No bookmarks yet. Use the Bookmark button on any lesson.</p>
      </section>
      <section class="card panel">
        <h2><Icon name="trophy" size={17} /> Quiz scores</h2>
        <ul class="list" data-quizzes={JSON.stringify(quizzes)}></ul>
        <p class="empty" data-quizzes-empty>No quizzes taken yet. <a href="/quiz/">Try one →</a></p>
      </section>
    </div>

    <section class="card panel known-panel">
      <h2><Icon name="briefcase" size={17} /> Interview questions marked as known</h2>
      <p><b data-known>0</b> questions. <a href="/interview/">Keep practising →</a></p>
    </section>

    <div class="danger">
      <button class="btn btn-sm" data-game-toggle aria-pressed="true"><Icon name="sparkles" size={14} /> <span>Game mode: on</span></button>
      <button class="btn btn-sm" data-reset><Icon name="reset" size={14} /> <span>Reset all progress</span></button>
    </div>
  </div>
</BaseLayout>

<script>
  import { progress } from '../scripts/progress';
  import { XP, gameEnabled, setGameEnabled, snapshot } from '../scripts/game';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function paint() {
    const done = new Set(progress.completed());
    document.querySelectorAll<HTMLElement>('[data-track]').forEach((card) => {
      const lessons: { key: string; url: string; title: string }[] = JSON.parse(card.dataset.lessons!);
      const count = lessons.filter((l) => done.has(l.key)).length;
      const pct = Math.round((count / lessons.length) * 100);
      card.querySelector('[data-count]')!.textContent = String(count);
      card.querySelector('[data-pct]')!.textContent = `${pct}%`;
      card.querySelector<HTMLElement>('[data-bar]')!.style.width = `${pct}%`;
      const next = lessons.find((l) => !done.has(l.key));
      const link = card.querySelector<HTMLAnchorElement>('[data-next]')!;
      if (next) {
        link.href = next.url;
        link.firstChild!.textContent = count ? 'Continue ' : 'Start ';
      } else {
        link.firstChild!.textContent = 'Completed 🎉 ';
      }
    });

    const bms = progress.bookmarks();
    const bmList = document.querySelector<HTMLElement>('[data-bookmarks]')!;
    bmList.innerHTML = bms
      .map(
        (b) =>
          `<li><a href="${esc(b.url)}"><span class="li-sec">${esc(b.section)}</span>${esc(b.title)}</a>
           <button class="rm" data-rm="${esc(b.key)}" aria-label="Remove bookmark">×</button></li>`,
      )
      .join('');
    document.querySelector<HTMLElement>('[data-bookmarks-empty]')!.hidden = bms.length > 0;
    bmList.querySelectorAll<HTMLButtonElement>('[data-rm]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const b = bms.find((x) => x.key === btn.dataset.rm)!;
        progress.toggleBookmark(b);
      }),
    );

    const scores = progress.quizScores();
    const qList = document.querySelector<HTMLElement>('[data-quizzes]')!;
    const quizzes: { id: string; title: string; total: number }[] = JSON.parse(qList.dataset.quizzes!);
    const taken = quizzes.filter((q) => scores[q.id]);
    qList.innerHTML = taken
      .map((q) => {
        const s = scores[q.id];
        const pct = Math.round((s.best / s.total) * 100);
        return `<li><a href="/quiz/${q.id}/">${esc(q.title)}</a><span class="score">${s.best}/${s.total} · ${pct}%</span></li>`;
      })
      .join('');
    document.querySelector<HTMLElement>('[data-quizzes-empty]')!.hidden = taken.length > 0;

    document.querySelector('[data-known]')!.textContent = String(progress.known().length);

    const g = snapshot();
    const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;
    $('[data-lv-index]').textContent = String(g.level.index);
    $('[data-lv-name]').textContent = g.level.name;
    $('[data-lv-bar]').style.width = `${g.pct}%`;
    $('[data-lv-next]').textContent = g.next
      ? `${g.next.xp - g.xp} XP to ${g.next.name}`
      : 'Top of the ladder — nothing left to prove.';
    $('[data-lv-xp]').textContent = g.xp.toLocaleString();
    $('[data-lv-streak]').textContent = String(g.streak.current);
    $('[data-lv-best]').textContent = String(g.streak.best);
    const b = g.breakdown;
    $('[data-lv-breakdown]').textContent =
      `Lessons ${b.lessons} · Interview Qs ${b.known} · Quizzes ${b.quizzes} · Active days ${b.streak} XP — ` +
      `earn ${XP.lesson} per lesson, ${XP.known} per known question, ${XP.activeDay} per active day, plus quiz XP.`;
    $('[data-badge-count]').textContent = `${g.badges.filter((x) => x.earned).length}/${g.badges.length}`;
    $('[data-badges]').innerHTML = g.badges
      .map(
        (x) => `<li class="badge${x.earned ? ' earned' : ''}" title="${esc(x.desc)}">
          <span class="b-emoji" aria-hidden="true">${x.emoji}</span>
          <span class="b-text"><b>${esc(x.name)}</b><small>${esc(x.desc)}</small>
          ${x.earned ? '<small class="b-done">Unlocked</small>' : `<span class="b-prog"><span style="width:${Number.isFinite(x.goal) ? Math.round((x.cur / x.goal) * 100) : 0}%"></span></span><small>${x.cur}/${Number.isFinite(x.goal) ? x.goal : '–'}</small>`}</span>
        </li>`,
      )
      .join('');

    const on = gameEnabled();
    gameBtn.setAttribute('aria-pressed', String(on));
    gameBtn.querySelector('span')!.textContent = on ? 'Game mode: on' : 'Game mode: off';
  }

  const gameBtn = document.querySelector<HTMLButtonElement>('[data-game-toggle]')!;
  gameBtn.addEventListener('click', () => setGameEnabled(!gameEnabled()));

  const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset]')!;
  let armed = false;
  resetBtn.addEventListener('click', () => {
    if (!armed) {
      armed = true;
      resetBtn.querySelector('span')!.textContent = 'Click again to confirm';
      setTimeout(() => {
        armed = false;
        resetBtn.querySelector('span')!.textContent = 'Reset all progress';
      }, 4000);
      return;
    }
    progress.reset();
    armed = false;
    resetBtn.querySelector('span')!.textContent = 'Progress reset';
  });

  window.addEventListener('jf:progress', paint);
  paint();
</script>

<style>
  .page {
    padding-top: 48px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 46px);
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .lede {
    color: var(--muted);
    margin: 0 0 32px;
  }
  .track-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .tp {
    padding: 20px;
  }
  .tp-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .tp-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .tp-title {
    font-weight: 650;
  }
  .tp-pct {
    margin-left: auto;
    font-weight: 700;
    font-size: 20px;
  }
  .tp .progress-bar span {
    background: var(--accent);
  }
  .tp-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .tp-foot b {
    color: var(--text);
  }
  .tp-foot a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent);
    font-weight: 600;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  .panel {
    padding: 22px;
  }
  .panel h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 17px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }
  .list :global(li a) {
    display: flex;
    flex-direction: column;
    font-weight: 550;
  }
  .list :global(li a:hover) {
    color: var(--brand);
  }
  .list :global(.li-sec) {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .list :global(.score) {
    font: 600 13px var(--font-mono);
    color: var(--ok);
  }
  .list :global(.rm) {
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 20px;
    cursor: pointer;
  }
  .empty {
    color: var(--muted);
    font-size: 14px;
    margin: 0;
  }
  .empty a,
  .known-panel a {
    color: var(--brand);
  }
  .known-panel {
    margin-top: 16px;
  }
  .known-panel p {
    margin: 0;
    color: var(--muted);
  }
  .known-panel b {
    color: var(--ok);
    font-size: 18px;
  }
  .danger {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .level-panel {
    padding: 24px;
    margin-bottom: 24px;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }
  .lv-main {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .lv-badge {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: var(--gradient);
    color: #fff;
    line-height: 1;
    flex-shrink: 0;
  }
  .lv-badge span {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.85;
    margin-top: 10px;
  }
  .lv-badge b {
    font-size: 30px;
    margin-bottom: 10px;
  }
  .lv-info {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lv-name {
    font-size: 22px;
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  .lv-next {
    font-size: 13.5px;
    color: var(--muted);
  }
  .lv-stats {
    display: flex;
    gap: 22px;
  }
  .lv-stats div {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lv-stats b {
    font-size: 22px;
  }
  .lv-stats span {
    font-size: 12px;
    color: var(--muted);
  }
  .lv-breakdown {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .level-panel h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    margin: 22px 0 12px;
  }
  .lv-count {
    font-size: 13px;
    color: var(--muted);
    font-weight: 500;
  }
  .badges {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .badges :global(.badge) {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  .badges :global(.badge:not(.earned) .b-emoji) {
    filter: grayscale(1);
    opacity: 0.45;
  }
  .badges :global(.badge.earned) {
    border-color: color-mix(in srgb, var(--brand-2) 45%, transparent);
    background: color-mix(in srgb, var(--brand-2) 7%, var(--surface-2));
  }
  .badges :global(.b-emoji) {
    font-size: 26px;
    line-height: 1;
  }
  .badges :global(.b-text) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }
  .badges :global(.b-text b) {
    font-size: 14px;
  }
  .badges :global(.b-text small) {
    font-size: 12px;
    color: var(--muted);
  }
  .badges :global(.b-done) {
    color: var(--ok) !important;
    font-weight: 600;
  }
  .badges :global(.b-prog) {
    display: block;
    height: 4px;
    border-radius: 4px;
    background: var(--surface);
    overflow: hidden;
  }
  .badges :global(.b-prog span) {
    display: block;
    height: 100%;
    background: var(--gradient);
  }
  @media (max-width: 860px) {
    .track-grid,
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
