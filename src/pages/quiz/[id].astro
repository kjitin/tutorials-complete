---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Quiz from '../../components/Quiz.astro';
import Icon from '../../components/Icon.astro';
import { QUIZZES } from '../../data/quizzes';
import type { Quiz as QuizData } from '../../data/quizzes/types';
import { trackById } from '../../site.config';

export function getStaticPaths() {
  return QUIZZES.map((quiz) => ({ params: { id: quiz.id }, props: { quiz } }));
}
const { quiz } = Astro.props as { quiz: QuizData };
const track = trackById(quiz.track);
---

<BaseLayout title={`${quiz.title} Quiz`} description={quiz.description}>
  <div class="container page" style={`--accent:${track.accent}`}>
    <div class="crumbs">
      <a href="/quiz/">Quizzes</a>
      <Icon name="chevron-right" size={14} />
      <span>{track.title}</span>
    </div>
    <h1>{quiz.title}</h1>
    <p class="lede">{quiz.description}</p>
    <Quiz quiz={quiz} />
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 820px;
    padding-top: 40px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .crumbs a {
    color: var(--accent);
    font-weight: 550;
  }
  h1 {
    font-size: clamp(30px, 4.6vw, 44px);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 12px;
  }
  .lede {
    font-size: 17.5px;
    color: var(--text-soft);
    margin: 0 0 28px;
  }
</style>
